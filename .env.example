# ── Ollama ──────────────────────────────────────
ANALYZER_MODEL=auditor-seguridad
EMBEDDING_MODEL=nomic-embed-text
OLLAMA_API_URL=http://localhost:11434/api
OLLAMA_BASE_URL=http://localhost:11434
LLM_TEMPERATURE=0.1
LLM_NUM_CTX=8192
LLM_NUM_PREDICT=2048
OLLAMA_TIMEOUT=120

# ── ChromaDB ────────────────────────────────────
CHROMA_HOST=localhost
CHROMA_PORT=8001
CHROMA_NVD_COLLECTION=nvd_vulnerabilities
CHROMA_EXPLOIT_COLLECTION=exploitdb_exploits
CHROMA_PAGE_SIZE=1000
CHROMA_QUERY_RESULTS=3

# ── NVD API ─────────────────────────────────────
NVD_API_BASE_URL=https://services.nvd.nist.gov/rest/json/cves/2.0
# NVD_API_KEY=                                     # Opcional: API key NIST para rate limit superior
NVD_DAYS_BACK=90
NVD_PAGE_SIZE=2000
NVD_API_TIMEOUT=30
NVD_API_DELAY=6.0                                  # 6s sin API key, 0.6s con API key
NVD_LAST_UPDATE_FILE=last_nvd_update.txt
NVD_UPDATE_INTERVAL_DAYS=7

# ── Embeddings ──────────────────────────────────
EMBED_BATCH_TIMEOUT=300
EMBED_MAX_RETRIES=2
EMBED_SINGLE_TIMEOUT=60

# ── Análisis ────────────────────────────────────
ANALYSIS_CHUNK_SIZE=8000
ANALYSIS_QUERY_LENGTH=500
REPORT_OUTPUT_DIR=reportes

# ── Optimización de análisis ────────────────────
ANALYSIS_MAX_WORKERS=3                             # Hilos paralelos para analizar archivos
ANALYSIS_USE_PROJECT_EMBEDDING=true                # Embedding único del proyecto (vs 1 por archivo)
ANALYSIS_COMBINE_SMALL_FILES=true                  # Agrupar archivos <50 líneas en un solo prompt
ANALYSIS_SMALL_FILE_LINES=50                       # Máx líneas para considerar archivo "pequeño"
ANALYSIS_MAX_FILE_SIZE_KB=512                      # Archivos >512KB se omiten
ANALYSIS_MAX_CONTEXT_CHARS=2000                    # Caracteres máximos del contexto RAG
ANALYSIS_AVG_TIME_PER_ITEM=15                      # Segundos promedio por item (para estimación inicial)

# ── MongoDB ─────────────────────────────────────
# MONGO_URI=mongodb://admin:password@localhost:27017/vulnerabilidades?authSource=admin
MONGO_DATABASE_NAME=vulnerabilidades
MONGO_TIMEOUT_MS=5000

# ── ExploitDB ───────────────────────────────────
EXPLOITDB_REPO_URL=https://gitlab.com/exploit-database/exploitdb.git
EXPLOITDB_LOCAL_DIR=./exploitdb-local
EXPLOIT_BATCH_SIZE=500
EXPLOIT_MAX_TEXT_LENGTH=2000

# ── OWASP Top 10 ─────────────────────────────────
OWASP_REPO_URL=https://github.com/OWASP/Top10.git
OWASP_LOCAL_DIR=./owasp-top10-local
OWASP_BATCH_SIZE=16
OWASP_MAX_TEXT_LENGTH=50000
CHROMA_OWASP_COLLECTION=owasp_top10_2025

# ── NVD batch ───────────────────────────────────
NVD_BATCH_SIZE=500

# ── Celery ──────────────────────────────────────
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# ── Validación / API Keys ───────────────────────
# DB_URL=postgresql://user:password@localhost:5432/openwebui
# API_KEY_SALT=my_secret_salt_here
VALIDATION_SERVICE_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:3000,https://seguridad.local
ANALIZADOR_API_KEY=                                 # API key por defecto para el CLI

# ── Dashboard / JWT ─────────────────────────────
# JWT_SECRET=cambiar_esto_jwt_secret               # Secreto para firmar tokens JWT del dashboard
# JWT_ACCESS_EXPIRE_MINUTES=15                      # Duración del access token
# JWT_REFRESH_EXPIRE_DAYS=7                         # Duración del refresh token
