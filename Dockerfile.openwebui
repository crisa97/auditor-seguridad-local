FROM ghcr.io/open-webui/open-webui:main

# ── Copiar módulos de validación ──────────────────────────────────────
COPY config.py /app/backend/config.py
COPY validador.py /app/backend/validador.py
COPY patches/openwebui_inject.py /app/backend/openwebui_inject.py
COPY src/ /app/backend/src/
COPY database/ /app/backend/database/

# Parche: modificar el main de Open WebUI para inyectar el middleware
COPY patches/inject_middleware.py /app/backend/inject_middleware.py
RUN python3 /app/backend/inject_middleware.py

EXPOSE 8080

CMD ["bash", "-c", "cd /app/backend && uvicorn open_webui.main:app --host 0.0.0.0 --port 8080 --forwarded-allow-ips '*'"]
